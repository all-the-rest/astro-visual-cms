---
import { type CollectionEntry, getCollection, render } from 'astro:content'

import SampleContactCallout from '../../components/SampleContactCallout.astro'
import SampleHero from '../../components/SampleHero.astro'
import ReisingerSampleLayout from '../../layouts/ReisingerSampleLayout.astro'

export async function getStaticPaths() {
  return (await getCollection('editorialSample')).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

type Props = { entry: CollectionEntry<'editorialSample'> }

const { entry } = Astro.props
const { Content } = await render(entry)
---

<ReisingerSampleLayout title={entry.data.title}>
  <meta slot="head" name="description" content={entry.data.description ?? ''} />
  <meta slot="head" property="article:published_time" content={entry.data.date.toISOString()} />
  <SampleHero
    slot="hero"
    title={entry.data.title}
    description={entry.data.description ?? ''}
    imageName={entry.data.heroImage}
  />
  <div slot="intro" class="alert alert-info" role="note">
    <span>Nur synthetische Inhalte und generierte Testbilder; keine Produktionsdaten.</span>
  </div>
  <article class="prose max-w-none">
    <Content />
  </article>
  <SampleContactCallout slot="postContact" />
</ReisingerSampleLayout>
