---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout>
  <main class="mx-auto max-w-4xl p-8">
    <h1 class="mb-4 text-3xl font-semibold">Astro visual CMS – sicher begrenzter Spike</h1>
    <p class="mb-6">Die MDX-Fixture ist eine echte Astro-Seite. Der lokale Editor läuft separat.</p>
    <div class="flex flex-wrap gap-3">
      <a class="btn" href={`${import.meta.env.BASE_URL}fixture/`}>Galerie-Fixture öffnen</a>
      <a class="btn btn-outline" href={`${import.meta.env.BASE_URL}reisinger-sample/editorial/showcase/`}>Komplexe synthetische Seite öffnen</a>
    </div>
  </main>
</BaseLayout>
