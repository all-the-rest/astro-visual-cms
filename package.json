{
  "name": "@astro-visual-cms/editor",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "files": ["src/editor/**", "src/lib/gallery-patch.mjs", "src/lib/astro-gallery-patch.mjs", "src/lib/demo-image-manifest.mjs", "src/lib/mdx-props-patch.mjs", "src/lib/markdown-paragraph-map.mjs", "docs/editor-package.md", "LICENSE"],
  "exports": {
    "./integration": "./src/editor/astro-integration.mjs",
    "./server": "./src/editor/server.mjs",
    "./cli": "./src/editor/cli.mjs"
  },
  "bin": { "astro-visual-cms-editor": "./src/editor/cli.mjs" },
  "scripts": {
    "pack:smoke": "node scripts/package-smoke.mjs",
    "dev": "node scripts/dev.mjs",
    "predev": "pnpm run fixtures:images",
    "dev:site": "astro dev --host 127.0.0.1 --port 4321 --strictPort",
    "dev:editor": "node src/editor/server.mjs",
    "fixtures:images": "node scripts/generate-noise.mjs",
    "build": "astro build",
    "prebuild": "pnpm run fixtures:images",
    "test": "node --test",
    "pretest": "pnpm run fixtures:images",
    "test:e2e": "node --test test/e2e.test.mjs",
    "pretest:e2e": "pnpm run fixtures:images",
    "browser-tests": "playwright test --config=playwright.config.ts",
    "browser-tests:readonly": "playwright test --config=playwright.readonly.config.ts",
    "browser-tests:unmapped": "playwright test --config=playwright.unmapped.config.ts",
    "browser-tests:gallery-copy": "playwright test --config=playwright.gallery-copy.config.ts",
    "browser-tests:collection-copy": "playwright test --config=playwright.collection-copy.config.ts",
    "browser-tests:markdown-copy": "playwright test --config=playwright.markdown-copy.config.ts",
    "browser-tests:markdown-draft-copy": "playwright test --config=playwright.markdown-draft-copy.config.ts",
    "browser-tests:mdx-conflict-copy": "playwright test --config=playwright.mdx-conflict.config.ts",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:external-production": "node scripts/verify-external-production.mjs",
    "verify:licenses": "node scripts/verify-runtime-licenses.mjs",
    "verify:sharp-build": "node scripts/verify-sharp-build.mjs",
    "verify:image-variants-astro": "node scripts/verify-image-variants-astro.mjs",
    "verify:collection-astro": "node scripts/verify-collection-astro.mjs",
    "verify:astro-compat": "node scripts/verify-astro-compat.mjs",
    "verify": "pnpm test && pnpm run verify:licenses && pnpm run verify:sharp-build && pnpm run verify:image-variants-astro && pnpm run verify:collection-astro && pnpm run verify:build"
  },
  "dependencies": {
    "@babel/parser": "7.29.13",
    "@mdx-js/mdx": "3.1.1",
    "yaml": "2.9.1"
  },
  "peerDependencies": { "astro": ">=7.2.4 <8" },
  "peerDependenciesMeta": { "astro": { "optional": true } },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "daisyui": "5.7.50",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "@astro-visual-cms/image-variants": "workspace:*",
    "@astrojs/mdx": "8.1.3",
    "astro": "7.4.7",
    "sharp": "0.35.5",
    "@axe-core/playwright": "4.14.0"
  }
}
